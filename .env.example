# ── App ─────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=development
PORT=3000
SERVICE_NAME=backend-claims-service
LOG_STACK=true
# Prefix for every route. Leave empty to serve /v1/... exactly as the API spec shows.
API_GLOBAL_PREFIX=
# Comma-separated allowed origins; empty reflects the caller (fine for local dev).
CORS_ORIGINS=
# Base URL of the Claims UI; scheduling links are built as <base>/schedule/<token>.
CLAIMS_UI_BASE_URL=http://localhost:5173

# ── Auth ────────────────────────────────────────────
# Local development only: skips token checks and runs every request as the user below.
# Environment validation rejects DISABLE_AUTH=true in staging/production.
DISABLE_AUTH=true
DISABLE_AUTH_USER_ID=user-207
DISABLE_AUTH_USER_ROLES=CLAIMS_ADMIN
# Required (32+ chars) in staging/production. Must match the platform gateway's signing secret.
AUTH_JWT_SECRET=change-me-in-production-change-me-in-production
AUTH_JWT_ALGORITHM=HS512
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600

# ── Workflow ────────────────────────────────────────
# true = the person who submitted an approval cannot decide it. Turn off locally so one
# dev user can walk a claim through every step.
MAKER_CHECKER_ENABLED=false

# ── Database (standalone claims DB — never the Fleetzen DB) ──
# false = services run on the in-memory store. Flip to true once the platform team provisions
# the database and the repository adapters are in place.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=claims
DB_SSL=false
DB_MAX_CONNECTIONS=30
DB_MIN_CONNECTIONS=5

# ── Swagger ─────────────────────────────────────────
SWAGGER_TITLE=Claims Service
SWAGGER_DESCRIPTION=API documentation for the claims service
SWAGGER_VERSION=1.0.0

# ── Upstreams (not yet integrated) ──────────────────
GATEWAY_API_BASE_URL=https://api.staging.myautochek.com
WALLET_SERVICE_URL=https://fleetpay.staging.myautochek.com
