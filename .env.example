NODE_ENV=development
ENVIRONMENT=development
PORT=3000
SERVICE_NAME=backend-claims-service
LOG_STACK=true

# Auth
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_ALGORITHM=HS512
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
DISABLE_AUTH=false

# Database
# Set to true once the platform-team claims DB is provisioned; false runs the service on mock data.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=claims
DB_SSL=false
DB_MAX_CONNECTIONS=30
DB_MIN_CONNECTIONS=5

# PubSub
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC_PREFIX=claims-

# External APIs
GATEWAY_API_BASE_URL=https://api.staging.myautochek.com
FLEETZEN_API_BASE_URL=https://api.fleetzen.autochek.africa
WALLET_SERVICE_URL=https://fleetpay.staging.myautochek.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
